# ═══════════════════════════════════════════════════════════════════════════
# ЕДИНЫЙ ФАЙЛ НАСТРОЕК ПРОЕКТА.  cp .env.example .env   и впишите свои значения.
# Читают его все приложения: apps/api, apps/web, apps/mini-app (и prisma-команды).
# .env в git НЕ попадает. На сервере (Render/Vercel) те же переменные задаются в панели хостинга.
# Переменные NEXT_PUBLIC_* уходят в браузер — секретов в них быть не должно.
# ═══════════════════════════════════════════════════════════════════════════

# ───────────── 1. SUPABASE ─────────────
# Supabase → Project Settings → API
# Project URL (одинаковый для api и web)
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# anon / publishable key — безопасен для браузера. Только в web.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Только для старых проектов с HS256 JWT secret (при новых ключах подписи оставьте закомментированным):
# SUPABASE_JWT_SECRET=
# service_role / secret key сюда НЕ вставляйте без необходимости (обходит все защиты базы).

# ───────────── 2. БАЗА ДАННЫХ ─────────────
# Локально (docker-compose из infrastructure/) — значения ниже подходят как есть.
# Supabase: Project Settings → Database → Connect.
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform
# Прямое подключение для миграций (Supabase: порт 5432, не pooler).
DIRECT_URL=postgresql://platform:platform@localhost:5432/platform
# База для интеграционных тестов. Имя ОБЯЗАТЕЛЬНО заканчивается на _test (схема в ней пересоздаётся).
# Закомментируйте, чтобы пропускать тесты БД.
TEST_DATABASE_URL=postgresql://platform:platform@localhost:5432/platform_test

# ───────────── 3. TELEGRAM MINI APP ─────────────
# Токен платформенного бота от @BotFather (открывает любой магазин; бренд может подключить своего бота в кабинете).
# ТОЛЬКО сервер, никогда NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
# Сколько секунд действительны данные запуска Mini App (initData)
TELEGRAM_INITDATA_MAX_AGE_SEC=600
# HTTPS-адрес Mini App (Telegram открывает только HTTPS) и публичный адрес API (для webhook ботов брендов)
PUBLIC_MINI_APP_URL=http://localhost:3001
# PUBLIC_API_URL=https://api.example.com
# Подпись наших токенов сессий (вход через Telegram). Сгенерировать: openssl rand -base64 48
JWT_SECRET=
# Ключ шифрования токенов ботов брендов в базе (32 байта, base64). Сгенерировать: openssl rand -base64 32
ENCRYPTION_KEY=
# Имя бота без @ (для ссылок t.me/<bot>?startapp=…)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Публичный HTTPS-адрес Mini App (его вы даёте BotFather)
NEXT_PUBLIC_MINI_APP_URL=http://localhost:3001

# ───────────── 4. АДРЕСА ПРИЛОЖЕНИЙ ─────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
# Необязательно: адрес API для серверов сайта/Mini App, если он другой (внутренняя сеть). Иначе берётся NEXT_PUBLIC_API_URL
# API_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Откуда браузеру разрешено обращаться к API (точные адреса через запятую: web, mini-app)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ───────────── 5. API (необязательное) ─────────────
NODE_ENV=development
PORT=4000
SWAGGER_ENABLED=true
THROTTLE_LIMIT=120
# true, если API стоит за reverse proxy (Render, Fly): IP клиента берётся из X-Forwarded-For
TRUST_PROXY=false
INVITATION_TTL_DAYS=7
# Выдать роль SUPER_ADMIN пользователю с этим email при `pnpm --filter @repo/api db:seed`
# SEED_SUPER_ADMIN_EMAIL=

# ───────────── 6. STRIPE (оплата тарифов, тестовый режим) ─────────────
# Stripe Dashboard → Developers → API keys (переключатель "Test mode"). Ключ начинается с sk_test_.
# ТОЛЬКО сервер. Живые ключи (sk_live_) API принимает лишь при NODE_ENV=production.
STRIPE_SECRET_KEY=
# Секрет подписи webhook: Developers → Webhooks → ваш endpoint → Signing secret (whsec_…),
# локально — его печатает `stripe listen` (см. docs/billing.md).
STRIPE_WEBHOOK_SECRET=
# Куда Stripe возвращает покупателя после оплаты (адрес web-приложения).
PUBLIC_WEB_URL=http://localhost:3000

# ───────────── Vercel (только для размещения API на Vercel) ─────────────
# Секрет для адресов расписания /api/v1/internal/cron/* (Vercel Cron шлёт его сам). 16+ символов. Пусто = адреса выключены
# CRON_SECRET=
