{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @repo/shared build && pnpm --filter @repo/api build",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": { "api/index.js": { "maxDuration": 30, "includeFiles": "dist/**" } },
  "crons": [
    { "path": "/api/v1/internal/cron/subscriptions", "schedule": "0 3 * * *" },
    { "path": "/api/v1/internal/cron/orders", "schedule": "30 3 * * *" }
  ]
}
